<Window x:Class="GlassWarehouseSystem.QueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="计划数据检索" Height="800" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF">
    <Grid Margin="15" Background="#EEEEEE">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="查询条件" Margin="0,0,0,20" Padding="15" Background="#EEEEEE">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="流程卡号" Width="70" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox x:Name="txtFlowCardNo" Width="180" Margin="5,0"/>

                    <TextBlock Text="订单号" Width="90" VerticalAlignment="Center" Margin="30,0,5,0"/>
                    <TextBox x:Name="txtOrderNo" Width="160" Margin="5,0"/>

                    <TextBlock Text="订序" Width="70" VerticalAlignment="Center" Margin="30,0,5,0"/>
                    <TextBox x:Name="txtOrderIndex" Width="100" Margin="5,0"/>

                    <TextBlock Text="小片ID" Width="70" VerticalAlignment="Center" Margin="30,0,5,0"/>
                    <TextBox x:Name="txtGlassID" Width="180" Margin="5,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="客户名称" Width="70" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox x:Name="txtClientName" Width="180" Margin="5,0"/>

                    <TextBlock Text="产品名称" Width="90" VerticalAlignment="Center" Margin="30,0,5,0"/>
                    <TextBox x:Name="txtProductName" Width="160" Margin="5,0"/>

                    <TextBlock Text="长边范围" Width="70" VerticalAlignment="Center" Margin="30,0,5,0"/>
                    <TextBox x:Name="txtLengthStart" Width="70" Margin="5,0"/>
                    <TextBlock Text="—" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                    <TextBox x:Name="txtLengthEnd" Width="70" Margin="5,0"/>

                    <TextBlock Text="短边范围" Width="70" VerticalAlignment="Center" Margin="30,0,5,0"/>
                    <TextBox x:Name="txtWidthStart" Width="70" Margin="5,0"/>
                    <TextBlock Text="—" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                    <TextBox x:Name="txtWidthEnd" Width="70" Margin="5,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="创建时间" Width="70" VerticalAlignment="Center" Margin="5,0"/>
                    <DatePicker x:Name="dtStart" Width="180" Margin="5,0" SelectedDate="{x:Static sys:DateTime.Now}"/>
                    <TextBlock Text="至" VerticalAlignment="Center" Margin="38,0" FontSize="14"/>
                    <DatePicker x:Name="dtEnd" Width="180" Margin="5,0" SelectedDate="{x:Static sys:DateTime.Now}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="btnQuery" Content="查询计划" Width="130" Height="45" Background="#99CCFF" FontSize="16" Margin="10,0"/>
            <Button x:Name="btnClear" Content="清除查询" Width="130" Height="45" Background="#99CCFF" FontSize="16" Margin="10,0"/>
        </StackPanel>

        <DataGrid x:Name="dgMaterial" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="#D3D3D3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding RowNo}" Width="60"/>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="120"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="产品分组" Binding="{Binding ProductGroup}" Width="100"/>
                <DataGridTextColumn Header="长边" Binding="{Binding Length}" Width="80"/>
                <DataGridTextColumn Header="短边" Binding="{Binding Width}" Width="80"/>
                <DataGridTextColumn Header="客户名称" Binding="{Binding ClientName}" Width="120"/>
                <DataGridTextColumn Header="分组名称" Binding="{Binding GroupName}" Width="120"/>
                <DataGridTextColumn Header="楼层号" Binding="{Binding ModelNo}" Width="100"/>
               
                <DataGridTextColumn Header="流程卡号" Binding="{Binding FlowCardNo}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>