<Window x:Class="GlassWarehouseSystem.Quanjvcanshu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局参数" Height="800" Width="1000" 
        Background="#F5F7FA" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" 
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 统一样式定义 -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <Style x:Key="InputControlStyle" TargetType="Control">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,2,5,2"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource InputControlStyle}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource InputControlStyle}"/>
        <Style TargetType="DatePicker" BasedOn="{StaticResource InputControlStyle}"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D1D8E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8F9FA"/>
                                <Setter Property="BorderBrush" Value="#A5B1C2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E9ECEF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="BorderBrush" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4AA3DF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="BorderBrush" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#58D68D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#E67E22"/>
            <Setter Property="BorderBrush" Value="#D35400"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EB984E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid 样式优化 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#ECF0F1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏区域 - 完全保持原样 -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" 
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnAdminLogin" Content="🔒 管理员登录" 
                        Style="{StaticResource SuccessButtonStyle}"
                        Click="BtnAdminLogin_Click"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="15,0"/>

                <Button x:Name="Btnjiaozhun" Content="📏 校准" 
                        Style="{StaticResource ActionButtonStyle}"
                        Click="BtnCalibrate_Click"/>
                <Button x:Name="BtnAdd" Content="➕ 新增" 
                        Style="{StaticResource ActionButtonStyle}"
                        Click="BtnAdd_Click"/>
                <Button x:Name="BtnSave" Content="💾 新增之后保存" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSaveToPLC_Click"/>
                <Button x:Name="BtnDelete" Content="🗑️ 删除" 
                        Style="{StaticResource WarningButtonStyle}"
                        Click="BtnDelete_Click"/>
                <Button x:Name="BtnSaveAll" Content="✏️ 修改并保存" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnUpdate_Click"/>
                <Button x:Name="BtnImport" Content="📂 导入Excel" 
                        Style="{StaticResource ActionButtonStyle}"
                        Click="BtnImport_Click"/>
            </StackPanel>
        </Border>

        <!-- 参数编辑区 -->
        <Border Grid.Row="1" CornerRadius="8" Background="White" 
                BorderBrush="#E5E9F0" BorderThickness="1" 
                Padding="0" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部标题栏 - 顿一点的长方形 -->
                <Border Grid.Row="0" Background="#5B8CB8" CornerRadius="8,8,0,0" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️" FontSize="16" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="参数配置面板" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="White" VerticalAlignment="Center"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="ClearType"/>
                        <TextBlock Text="· 编辑或新增参数信息" FontSize="12" 
                                   Foreground="#D4E4F0" VerticalAlignment="Center" Margin="12,0,0,0"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="ClearType"/>
                    </StackPanel>
                </Border>

                <!-- 内容区 -->
                <Border Grid.Row="1" Padding="22,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="130"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="130"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="130"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 第1行 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="编号" 
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,10"/>
                        <TextBox x:Name="txtConfigID" Grid.Row="0" Grid.Column="1" 
                                 Text="（保存后自动生成）" IsReadOnly="True" 
                                 Background="#F8F9FA" Cursor="Arrow" Margin="0,0,16,10"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="数据类型" 
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,10"/>
                        <ComboBox x:Name="cmbType" Grid.Row="0" Grid.Column="3" 
                                  SelectedIndex="0" Margin="0,0,16,10">
                            <ComboBoxItem Content="int"/>
                            <ComboBoxItem Content="bool"/>
                            <ComboBoxItem Content="double"/>
                            <ComboBoxItem Content="short"/>
                            <ComboBoxItem Content="string"/>
                            <ComboBoxItem Content="float"/>
                        </ComboBox>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="参数分类" 
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,10"/>
                        <ComboBox x:Name="cmb2Type" Grid.Row="0" Grid.Column="5" 
                                  SelectedIndex="0" Margin="0,0,0,10">
                            <ComboBoxItem Content="软件参数"/>
                            <ComboBoxItem Content="全局参数"/>
                            <ComboBoxItem Content="实时参数"/>
                        </ComboBox>

                        <!-- 第2行 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="参数名称" 
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,10"/>
                        <TextBox x:Name="txtKeyName" Grid.Row="1" Grid.Column="1" 
                                 Margin="0,0,16,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="参数值" 
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,10"/>
                        <TextBox x:Name="txtValue" Grid.Row="1" Grid.Column="3" 
                                 Margin="0,0,16,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="PLC地址" 
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,10"/>
                        <TextBox x:Name="txtAddress" Grid.Row="1" Grid.Column="5" 
                                 Margin="0,0,0,10"/>

                        <!-- 第3行 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="更新时间" 
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,10"/>
                        <DatePicker x:Name="dpUpdateTime" Grid.Row="2" Grid.Column="1" 
                                    SelectedDateFormat="Short" Margin="0,0,16,10"/>

                        <!-- 第4行 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="参数描述" 
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,0"/>
                        <TextBox x:Name="txtDescribe" 
                                 Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5"
                                 Height="52" HorizontalAlignment="Stretch"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="8,6"
                                 Margin="0,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 数据表格区 -->
        <Border Grid.Row="2" CornerRadius="8" Background="White" 
                BorderBrush="#E5E9F0" BorderThickness="1" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部标题栏 - 顿一点的长方形 -->
                <Border Grid.Row="0" Background="#5B8CB8" CornerRadius="8,8,0,0" Padding="16,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="📋" FontSize="16" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="参数数据列表" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="White" VerticalAlignment="Center"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock Text="· 点击行可选中，支持多选操作" FontSize="12" 
                                       Foreground="#D4E4F0" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"/>
                        </StackPanel>
                        
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" x:Name="IODataGrid" 
                          SelectionMode="Extended" SelectionUnit="FullRow" 
                          ItemsSource="{Binding ConfigList}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          Background="White" 
                          AlternatingRowBackground="#FAFBFC"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF2F7"
                          VerticalGridLinesBrush="#EDF2F7"
                          RowHeight="42"
                          ColumnHeaderHeight="38"
                          SelectionChanged="IODataGrid_SelectionChanged"
                          BorderThickness="0"
                          EnableRowVirtualization="True"
                          Margin="0,1,0,0">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EBF3FA"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F8FC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="✓" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Focusable="False" IsHitTestVisible="False"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="编号" Binding="{Binding ConfigID}" IsReadOnly="True" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#5B8CB8"/>
                                    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                                    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="数据类型" Binding="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="分类" Binding="{Binding Type2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="参数名称" Binding="{Binding KeyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="参数值" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="PLC地址" Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="130" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="参数描述" Width="*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Describe}" 
                                               TextWrapping="Wrap" 
                                               VerticalAlignment="Center" 
                                               Margin="8,4"
                                               ToolTip="{Binding Describe}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="56"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="更新时间" 
                                            Binding="{Binding UpdateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" 
                                            IsReadOnly="True" 
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>