<Window x:Class="GlassWarehouseSystem.MeasurementPlatformHmiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HMIUI"
        Height="780"
        Width="960"
        MinHeight="640"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        TextOptions.TextFormattingMode="Display" 
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="ThemeBlueGreen" Color="#1D809F"/>
        <SolidColorBrush x:Key="ThemeBlueGreenLight" Color="#E8F4F8"/>

        <SolidColorBrush x:Key="BrushInactive" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BrushActive" Color="#1D809F"/>
        <SolidColorBrush x:Key="BrushExecute" Color="#F39C12"/>
        <SolidColorBrush x:Key="BrushIndicatorOff" Color="#E74C3C"/>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4,4,4,12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#1D809F" CornerRadius="7,7,0,0" Padding="14,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="4" Height="14" Background="#63C5DA" CornerRadius="2" Margin="0,0,8,0"/>
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" 
                                                          TextElement.Foreground="White" 
                                                          TextElement.FontWeight="SemiBold" 
                                                          TextElement.FontSize="14"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Padding="16,12">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BigModeButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="StationTabButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="JogButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D8E0"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style x:Key="ExecuteButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{StaticResource BrushExecute}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ValueDisplay" TargetType="TextBox">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F1F8F8"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderBrush" Value="#A3D2CA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="WhiteReadOnly" TargetType="TextBox" BasedOn="{StaticResource ValueDisplay}">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#D1D8E0"/>
            <Setter Property="Width" Value="88"/>
        </Style>

        <Style x:Key="GreenInput" TargetType="TextBox" BasedOn="{StaticResource ValueDisplay}">
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#1D809F"/>
        </Style>

        <Style x:Key="CageYJogButton" TargetType="Button" BasedOn="{StaticResource JogButton}">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" 
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnModeAuto" Content="自动" Style="{StaticResource BigModeButton}"
                                Background="{StaticResource BrushInactive}" Foreground="White"
                                Click="BtnModeAuto_Click"/>
                        <Button x:Name="BtnModeManual" Content="手动" Style="{StaticResource BigModeButton}"
                                Background="{StaticResource BrushActive}" Foreground="White"
                                Click="BtnModeManual_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnStationMeasure" Content="测量台" Style="{StaticResource StationTabButton}"
                                Background="{StaticResource BrushActive}" Foreground="White"
                                Click="BtnStationMeasure_Click"/>
                        <Button x:Name="BtnStationCageA" Content="A 笼" Style="{StaticResource StationTabButton}"
                                Background="{StaticResource BrushInactive}" Foreground="White"
                                Click="BtnStationCageA_Click"/>
                        <Button x:Name="BtnStationCageB" Content="B 笼" Style="{StaticResource StationTabButton}"
                                Background="{StaticResource BrushInactive}" Foreground="White"
                                Click="BtnStationCageB_Click"/>
                        <Button x:Name="BtnStationAToB" Content="A笼-&gt;B笼" Style="{StaticResource StationTabButton}"
                                Background="{StaticResource BrushInactive}" Foreground="White"
                                Click="BtnStationAToB_Click"/>
                        <Button x:Name="BtnStationOut" Content="出片台" Style="{StaticResource StationTabButton}"
                                Background="{StaticResource BrushInactive}" Foreground="White"
                                Click="BtnStationOut_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                        <TextBox x:Name="TxtClockDate" Width="110" Height="30" VerticalContentAlignment="Center"
                                 IsReadOnly="True" Background="#F8F9FA" BorderBrush="#E2E8F0" TextAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        <TextBox x:Name="TxtClockTime" Width="90" Height="30" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                 IsReadOnly="True" Background="#F8F9FA" BorderBrush="#E2E8F0" TextAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <CheckBox x:Name="ChkManualTestEnable" Grid.Row="1" Content="手动测试使能" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="4,0,0,12"
                  Checked="ChkManualTestEnable_Changed" Unchecked="ChkManualTestEnable_Changed"/>

        <Grid Grid.Row="2" MinHeight="280">
            <Grid x:Name="PnlStationMeasure" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" MinHeight="260" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="独立手动">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button x:Name="BtnIndZPlus" Grid.Row="0" Content="Z+" Style="{StaticResource JogButton}" HorizontalAlignment="Center"
                                    IsEnabled="False"
                                    PreviewMouseLeftButtonDown="JogIndependent_PreviewMouseDown"
                                    PreviewMouseLeftButtonUp="Jog_PreviewMouseUp"
                                    LostMouseCapture="Jog_LostMouseCapture"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnIndConvXm" Content="传送台X-" Style="{StaticResource JogButton}" IsEnabled="False"
                                        PreviewMouseLeftButtonDown="JogIndependent_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="Jog_PreviewMouseUp"
                                        LostMouseCapture="Jog_LostMouseCapture"/>
                                <Button x:Name="BtnIndConvXp" Content="传送台X+" Style="{StaticResource JogButton}" IsEnabled="False"
                                        PreviewMouseLeftButtonDown="JogIndependent_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="Jog_PreviewMouseUp"
                                        LostMouseCapture="Jog_LostMouseCapture"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnIndMeasXm" Content="测量台X-" Style="{StaticResource JogButton}" IsEnabled="False"
                                        PreviewMouseLeftButtonDown="JogIndependent_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="Jog_PreviewMouseUp"
                                        LostMouseCapture="Jog_LostMouseCapture"/>
                                <Button x:Name="BtnIndMeasXp" Content="测量台X+" Style="{StaticResource JogButton}" IsEnabled="False"
                                        PreviewMouseLeftButtonDown="JogIndependent_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="Jog_PreviewMouseUp"
                                        LostMouseCapture="Jog_LostMouseCapture"/>
                            </StackPanel>
                            <Button x:Name="BtnIndZMinus" Grid.Row="3" Content="Z-" Style="{StaticResource JogButton}" HorizontalAlignment="Center"
                                    IsEnabled="False"
                                    PreviewMouseLeftButtonDown="JogIndependent_PreviewMouseDown"
                                    PreviewMouseLeftButtonUp="Jog_PreviewMouseUp"
                                    LostMouseCapture="Jog_LostMouseCapture"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="原点 / 清零">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="设置Z轴原点" FontSize="13" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <CheckBox x:Name="ChkZOriginEnable" Content="启用" VerticalAlignment="Center" Margin="0,0,16,0"
                                          Checked="ChkZOriginEnable_Changed" Unchecked="ChkZOriginEnable_Changed"/>
                                <Button x:Name="BtnZOriginSet" Content="设置" Width="80" Height="32" IsEnabled="False" Click="BtnZOriginSet_Click"
                                        Background="White" BorderBrush="#D1D8E0" BorderThickness="1" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="X轴位置清零" FontSize="13" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <Button x:Name="BtnXClearSet" Content="设置" Width="80" Height="32" HorizontalAlignment="Left"
                                    IsEnabled="False" Click="BtnXClearSet_Click"
                                    Background="White" BorderBrush="#D1D8E0" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="联动手动">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnLnkZPlus" Grid.Row="0" Grid.Column="1" Content="Z+" Style="{StaticResource JogButton}"
                                        IsEnabled="False"
                                        PreviewMouseLeftButtonDown="JogLinked_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="Jog_PreviewMouseUp"
                                        LostMouseCapture="Jog_LostMouseCapture"/>
                                <Button x:Name="BtnLnkXm" Grid.Row="1" Grid.Column="0" Content="X-" Style="{StaticResource JogButton}"
                                        IsEnabled="False"
                                        PreviewMouseLeftButtonDown="JogLinked_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="Jog_PreviewMouseUp"
                                        LostMouseCapture="Jog_LostMouseCapture"/>
                                <Button x:Name="BtnLnkXp" Grid.Row="1" Grid.Column="2" Content="X+" Style="{StaticResource JogButton}"
                                        IsEnabled="False"
                                        PreviewMouseLeftButtonDown="JogLinked_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="Jog_PreviewMouseUp"
                                        LostMouseCapture="Jog_LostMouseCapture"/>
                                <Button x:Name="BtnLnkZMinus" Grid.Row="2" Grid.Column="1" Content="Z-" Style="{StaticResource JogButton}"
                                        IsEnabled="False"
                                        PreviewMouseLeftButtonDown="JogLinked_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="Jog_PreviewMouseUp"
                                        LostMouseCapture="Jog_LostMouseCapture"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8" VerticalAlignment="Center">
                                <TextBlock Text="X轴目标位置" VerticalAlignment="Center" Width="90" Margin="0,0,8,0" Foreground="#2C3E50"/>
                                <TextBox x:Name="TxtTargetX" Style="{StaticResource ValueDisplay}" Text="0.00" IsReadOnly="False" Background="#E8F4F8"/>
                                <Button x:Name="BtnLnkXExec" Content="执行" Style="{StaticResource ExecuteButton}" Margin="10,0,0,0"
                                        IsEnabled="False" Click="BtnLnkXExec_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="Z轴目标位置" VerticalAlignment="Center" Width="90" Margin="0,0,8,0" Foreground="#2C3E50"/>
                                <TextBox x:Name="TxtTargetZ" Style="{StaticResource ValueDisplay}" Text="0.00" IsReadOnly="False" Background="#E8F4F8"/>
                                <Button x:Name="BtnLnkZExec" Content="执行" Style="{StaticResource ExecuteButton}" Margin="10,0,0,0"
                                        IsEnabled="False" Click="BtnLnkZExec_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <Border Grid.Row="1" Background="#F1F8F8" BorderBrush="#B2DFDB" BorderThickness="1" Padding="20,16" Margin="4,0,4,0" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="传送台位置" Width="90" VerticalAlignment="Center" Foreground="#2C3E50" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtPosConveyor" Style="{StaticResource ValueDisplay}" Text="0.00"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="测量台位置" Width="90" VerticalAlignment="Center" Foreground="#2C3E50" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtPosMeasure" Style="{StaticResource ValueDisplay}" Text="0.00"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="Z轴位置" Width="90" VerticalAlignment="Center" Foreground="#2C3E50" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtPosZ" Style="{StaticResource ValueDisplay}" Text="0.00"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkMeasureMode" Content="启用测量模式" FontSize="14" FontWeight="SemiBold" Foreground="#1D809F" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="X轴长度" Width="90" VerticalAlignment="Center" Foreground="#2C3E50" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtLenX" Style="{StaticResource ValueDisplay}" Text="0.00"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="Z轴高度" Width="90" VerticalAlignment="Center" Foreground="#2C3E50" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtHeightZ" Style="{StaticResource ValueDisplay}" Text="0.00"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="PnlStationCageA" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="4,0,4,10" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="传送台位置:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#2C3E50" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtCageA_StatusConveyor" Style="{StaticResource WhiteReadOnly}" Text="0.00"/>
                        <TextBlock Text="测量台位置:" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="#2C3E50" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtCageA_StatusMeasure" Style="{StaticResource WhiteReadOnly}" Text="0.00"/>
                        <TextBlock Text="单向台位置:" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="#2C3E50" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtCageA_StatusOneWay" Style="{StaticResource WhiteReadOnly}" Text="0.00"/>
                    </StackPanel>
                </Border>

                <Grid x:Name="PnlCageA_ManualHost" Grid.Row="1" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="A笼巷道位置">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                            <StackPanel>
                                <Border Margin="0,0,0,8" Background="#F8F9FA" Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="巷道号" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                        <TextBlock Grid.Column="1" Text="巷道位置" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="PnlCageA_Aisles"/>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>

                    <StackPanel Grid.Column="1">
                        <GroupBox Header="Y轴定位">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <TextBlock Text="Y轴实时位置" Width="90" VerticalAlignment="Center" Foreground="#2C3E50"/>
                                    <TextBox x:Name="TxtCageA_YRealtime" Style="{StaticResource WhiteReadOnly}" Text="0.00"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <TextBlock Text="当前巷道号" Width="90" VerticalAlignment="Center" Foreground="#2C3E50"/>
                                    <TextBox x:Name="TxtCageA_CurrentAisle" Style="{StaticResource WhiteReadOnly}" Text="0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <TextBlock Text="目标Y轴位置" Width="90" VerticalAlignment="Center" Foreground="#2C3E50"/>
                                    <TextBox x:Name="TxtCageA_YTarget" Style="{StaticResource GreenInput}" Text="0.00"/>
                                    <Button x:Name="BtnCageA_YTargetExec" Content="执行" Style="{StaticResource ExecuteButton}" Margin="10,0,0,0"
                                            Click="BtnCageA_YTargetExec_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <TextBlock Text="目标巷道号" Width="90" VerticalAlignment="Center" Foreground="#2C3E50"/>
                                    <TextBox x:Name="TxtCageA_AisleTarget" Style="{StaticResource GreenInput}" Text="0"/>
                                    <Button x:Name="BtnCageA_AisleTargetExec" Content="执行" Style="{StaticResource ExecuteButton}" Margin="10,0,0,0"
                                            Click="BtnCageA_AisleTargetExec_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="升降气缸">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8" VerticalAlignment="Center">
                                    <Button x:Name="BtnCageA_LiftUp" Content="上升" Width="72" Height="32" Margin="0,0,16,0"
                                            Style="{StaticResource JogButton}"
                                            PreviewMouseLeftButtonDown="JogCage_PreviewMouseDown"
                                            PreviewMouseLeftButtonUp="Jog_PreviewMouseUp"
                                            LostMouseCapture="Jog_LostMouseCapture"/>
                                    <Ellipse Width="18" Height="18" Fill="{StaticResource BrushIndicatorOff}" VerticalAlignment="Center"/>
                                    <TextBlock Text="到位" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#2C3E50" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8" VerticalAlignment="Center">
                                    <Button x:Name="BtnCageA_LiftDown" Content="下降" Width="72" Height="32" Margin="0,0,16,0"
                                            Style="{StaticResource JogButton}"
                                            PreviewMouseLeftButtonDown="JogCage_PreviewMouseDown"
                                            PreviewMouseLeftButtonUp="Jog_PreviewMouseUp"
                                            LostMouseCapture="Jog_LostMouseCapture"/>
                                    <Ellipse Width="18" Height="18" Fill="{StaticResource BrushIndicatorOff}" VerticalAlignment="Center"/>
                                    <TextBlock Text="到位" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#2C3E50" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <GroupBox Header="X轴手动">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Center">
                                    <RadioButton x:Name="RbCageA_X_Conveyor" GroupName="CageAXSelect" Content="输送台" Margin="0,0,12,0" IsChecked="True"/>
                                    <RadioButton x:Name="RbCageA_X_Measure" GroupName="CageAXSelect" Content="测量台" Margin="0,0,12,0"/>
