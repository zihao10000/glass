<Window x:Class="GlassWarehouseSystem.InboundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Window.Inbound}"
        Height="900"
        Width="1600"
        WindowState="Maximized"
        Background="#EAEBED">

    <Window.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- 启动按钮：禁用时字体显黑色 -->
        <Style x:Key="StartButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 停止按钮：禁用时字体显黑色 -->
        <Style x:Key="StopButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--  -->
        <Border Grid.Row="0" Background="#D4D4D4">
            <Menu IsMainMenu="True" Background="#D4D4D4" FontSize="11">
                <MenuItem x:Name="menuSystem" Header="{DynamicResource Menu.System}">
                    <MenuItem x:Name="menuExit" Header="{DynamicResource Menu.Exit}" Click="MenuExit_Click"/>
                </MenuItem>
                <MenuItem x:Name="menuConfig" Header="{DynamicResource Menu.Config}">
                    <MenuItem Header="{DynamicResource Menu.ParamSettings}" Click="OpenGlobalParams_Click"/>
                    <MenuItem Header="{DynamicResource Menu.SystemSettings}" Click="OpenSystemSettings_Click"/>
                    <MenuItem Header="{DynamicResource Menu.ParamManage}" Click="OpenCanShuGuanLi_Click"/>
                    <MenuItem Header="{DynamicResource Menu.GlobalParam}" Click="OpenQuanjvcanshu_Click"/>
                    <MenuItem Header="{DynamicResource Menu.PLCControl}" Click="OpenControlPlc_Click"/>
                    <MenuItem Header="{DynamicResource Menu.CageLayer}" Click="OpenCageLayerManagement_Click"/>
                    <MenuItem Header="{DynamicResource Menu.License}" Click="OpenLicense_Click"/>
                </MenuItem>
                <MenuItem x:Name="menuPlan" Header="{DynamicResource Menu.Plan}">
                    <MenuItem Header="{DynamicResource Menu.PrintLabel}" Click="MenuPrintLabel_Click"/>
                </MenuItem>
                <MenuItem x:Name="menuReport" Header="{DynamicResource Menu.Report}">
                    <MenuItem Header="{DynamicResource Menu.DashboardA}" Click="MenuCageDashboard_Click"/>
                    <MenuItem Header="{DynamicResource Menu.DashboardB}" Click="MenuCageDashboard_Click"/>
                    <MenuItem Header="{DynamicResource Menu.QueryWindow}" Click="OpenQueryWindow_Click"/>
                    <MenuItem Header="{DynamicResource Menu.LogWindow}" Click="OpenLogWindow_Click"/>
                    <MenuItem Header="{DynamicResource Menu.MeasurementPlatform}" Click="OpenMeasurementPlatform_Click"/>
                </MenuItem>
                <MenuItem x:Name="menuLanguage" Header="{DynamicResource Menu.Language}">
                    <MenuItem x:Name="menuLangChinese" Header="中文" Tag="zh-CN" Click="MenuLanguage_Click"/>
                    <MenuItem x:Name="menuLangEnglish" Header="English" Tag="en-US" Click="MenuLanguage_Click"/>
                    <MenuItem x:Name="menuLangRussian" Header="Русский" Tag="ru-RU" Click="MenuLanguage_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <!--  -->
        <Border Grid.Row="1" Background="#F5F5F5" BorderThickness="0,0,0,1" BorderBrush="#CCCCCC">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Stretch">

                    <Button Style="{StaticResource ToolButtonStyle}" Click="OpenQuanjvcanshu_Click" 
                    Width="65" Height="Auto" VerticalAlignment="Stretch" 
                    Margin="1,0" BorderThickness="0" Background="Transparent" Padding="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="/GlassWarehouseSystem;component/tubiaoimages/SystemSet.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" Height="59"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Toolbar.Param}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,1,0,1"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}" Click="MenuPrintLabel_Click"
                    Width="65" Height="Auto" VerticalAlignment="Stretch" 
                    Margin="1,0" BorderThickness="0" Background="Transparent" Padding="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Source="/GlassWarehouseSystem;component/tubiaoimages/Device.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" Height="59"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Toolbar.PrintLabel}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,1,0,1"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}" Click="MenuCageDashboard_Click"
                    Width="65" Height="Auto" VerticalAlignment="Stretch" 
                    Margin="1,0" BorderThickness="0" Background="Transparent" Padding="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="/GlassWarehouseSystem;component/tubiaoimages/CageScreen.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" Height="59"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Toolbar.CageScreen}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,1,0,1"/>
                        </Grid>
                    </Button>

                    <Separator Width="1" Background="#CCCCCC" Margin="3,4"/>

                    <Button Style="{StaticResource ToolButtonStyle}" Click="MenuPlan_Click"
                    Width="65" Height="Auto" VerticalAlignment="Stretch" 
                    Margin="1,0" BorderThickness="0" Background="Transparent" Padding="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="/GlassWarehouseSystem;component/tubiaoimages/Plan.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" Height="59"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Toolbar.PlanManage}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,1,0,1"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}" Click="MenuOneWay_Click"
                    Width="65" Height="Auto" VerticalAlignment="Stretch" 
                    Margin="1,0" BorderThickness="0" Background="Transparent" Padding="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="/GlassWarehouseSystem;component/tubiaoimages/OneWay.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" Height="59"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Toolbar.OneWay}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,1,0,1"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}" Click="MenuGlassTrace_Click"
                    Width="65" Height="Auto" VerticalAlignment="Stretch" 
                    Margin="1,0" BorderThickness="0" Background="Transparent" Padding="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="/GlassWarehouseSystem;component/tubiaoimages/GlassTrace.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" Height="59"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Toolbar.GlassTrace}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,1,0,1"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}" Click="MenuGlobal_Click"
                    Width="65" Height="Auto" VerticalAlignment="Stretch" 
                    Margin="1,0" BorderThickness="0" Background="Transparent" Padding="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="/GlassWarehouseSystem;component/tubiaoimages/Global.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" Height="59"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Toolbar.SystemSet}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,1,0,1"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}" Click="MenuIoPort_Click"
                    Width="65" Height="Auto" VerticalAlignment="Stretch" 
                    Margin="1,0" BorderThickness="0" Background="Transparent" Padding="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="/GlassWarehouseSystem;component/tubiaoimages/IoPort.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" Height="59"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Toolbar.IoPort}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,1,0,1"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}" Click="MenuRegister_Click"
                    Width="65" Height="Auto" VerticalAlignment="Stretch" 
                    Margin="1,0" BorderThickness="0" Background="Transparent" Padding="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="/GlassWarehouseSystem;component/tubiaoimages/Register.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" Height="59"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Toolbar.Register}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,1,0,1"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}" Click="MenuSlice_Click"
                    Width="65" Height="Auto" VerticalAlignment="Stretch" 
                    Margin="1,0" BorderThickness="0" Background="Transparent" Padding="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="/GlassWarehouseSystem;component/tubiaoimages/Slice.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" Height="59"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Toolbar.Slice}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,1,0,1"/>
                        </Grid>
                    </Button>

                    <Separator Width="1" Background="#CCCCCC" Margin="4,4"/>
                </StackPanel>
            </ScrollViewer>
        </Border>


        <!--  -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--  -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <!-- 操作按钮行 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Content="导入Excel" Style="{StaticResource ActionButtonStyle}" Click="BtnImportExcel_Click" Background="#2196F3" Foreground="White"/>
                    <Button Content="复位设备" Style="{StaticResource ActionButtonStyle}" Click="BtnResetPlc_Click" Background="#FF9800" Foreground="White"/>
                    <Button Content="导出理片汇总" Style="{StaticResource ActionButtonStyle}" Click="BtnExportSummary_Click" Background="#4CAF50" Foreground="White"/>
                    <Button Content="导出待补片" Style="{StaticResource ActionButtonStyle}" Click="BtnExportMissing_Click" Background="#00ACC1" Foreground="White"/>
                    <Button x:Name="btnScanFlowCard" Content="流程卡扫码" Style="{StaticResource ActionButtonStyle}" Click="BtnScanFlowCard_Click" Background="#FF178D17" Foreground="White"/>
                </StackPanel>

                <!--  -->
                <DataGrid Grid.Row="1" x:Name="dgPlan"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Extended"
                         SelectionUnit="FullRow"
                         CanUserAddRows="False"
                         GridLinesVisibility="All"
                         HeadersVisibility="Column"
                         Background="White"
                         BorderBrush="#999999"
                         BorderThickness="1"
                         FontSize="12"
                         RowHeight="25"
                         Margin="0,0,0,5"
                         SelectionChanged="DgPlan_SelectionChanged">
                    <!-- 行底色：待入库=浅蓝，在库=白，破损=浅红，异常=浅橙 -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#CCE8FF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInStock}" Value="True">
                                    <Setter Property="Background" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDamaged}" Value="True">
                                    <Setter Property="Background" Value="#FFCCCC"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="#FFE0B2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="行号" Binding="{Binding RowNo}" Width="50"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="60"/>
                        <DataGridTextColumn Header="订单号" Binding="{Binding OrderNo}" Width="100"/>
                        <DataGridTextColumn Header="订单名称" Binding="{Binding OrderName}" Width="120"/>
                        <DataGridTextColumn Header="长边(mm)" Binding="{Binding Length, StringFormat={}{0:F3}}" Width="80"/>
                        <DataGridTextColumn Header="短边(mm)" Binding="{Binding Width, StringFormat={}{0:F3}}" Width="80"/>
                        <DataGridTextColumn Header="GlassID" Binding="{Binding ID}" Width="100"/>
                        <DataGridTextColumn Header="产品名称" Binding="{Binding Name}" Width="140"/>
                        <DataGridTextColumn Header="客户名称" Binding="{Binding ClientName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  -->
                <Border Grid.Row="2" Background="#F9F9F9" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,5" Padding="8,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtDetailTitle" Grid.Row="0" Grid.ColumnSpan="4"
                                   Text="详细信息" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtDetailID" Grid.Row="1" Grid.Column="0"
                                   Text="ID: --" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,4,4"/>
                        <TextBlock x:Name="txtDetailFlow" Grid.Row="1" Grid.Column="1"
                                   Text="订单号: --" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,4,4"/>
                        <TextBlock x:Name="txtDetailClient" Grid.Row="1" Grid.Column="2"
                                   Text="客户: --" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,4,4"/>
                        <TextBlock x:Name="txtDetailOrder" Grid.Row="1" Grid.Column="3"
                                   Text="订单名称: --" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtDetailSize" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="短边: --  长边: --  厚度: --" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                        <TextBlock x:Name="txtDetailProduct" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                   Text="产品名称: --" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,0"/>
                    </Grid>
                </Border>

                <!--  -->
                <StackPanel Grid.Row="3" Margin="0,0,0,5">
                    <!-- 操作按钮行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Button Content="标记破损" Style="{StaticResource ActionButtonStyle}" Click="BtnMarkDamaged_Click" Background="#FFFF433E" Foreground="White"/>
                        <Button Content="手动报工" Style="{StaticResource ActionButtonStyle}" Click="BtnManualReport_Click" Background="#43A047" Foreground="White"/>
                        <Button Content="顺移A→B" Style="{StaticResource ActionButtonStyle}" Click="BtnShiftAB_Click" Background="#FB8C00" Foreground="White"/>
                        <Button Content="手动确认入库" Style="{StaticResource ActionButtonStyle}" Click="BtnManualInstock_Click" Background="#1E88E5" Foreground="White"/>
                    </StackPanel>

                    <!-- 参数设置区域  -->
                    <Border Background="#E1D5E7" BorderBrush="#9673A6" BorderThickness="1" Padding="10,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="参数设置" FontWeight="Bold" FontSize="12" Margin="0,0,20,8"/>
                            <TextBlock x:Name="txtSortMethod" Text="测量误差: --" FontSize="11" Margin="0,2,16,2"/>
                            <TextBlock x:Name="txtGapSize" Text="安全间距: --" FontSize="11" Margin="0,2,16,2"/>
                            <TextBlock x:Name="txtDataSource" Text="数据来源: --" FontSize="11" Margin="0,2,16,2"/>
                            <TextBlock x:Name="txtScanRetry" Text="扫码重试: --" FontSize="11" Margin="0,2,0,2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  -->
                <Border Grid.Row="4" Background="#D5E8D4" BorderBrush="#82B366" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="运行日志" FontWeight="Bold" Margin="5"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="txtLog"
                                    TextWrapping="Wrap"
                                    IsReadOnly="True"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    FontFamily="Courier New"
                                    FontSize="11"
                                    Padding="5"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!--  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--  -->
                <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="异常数据" FontWeight="Bold" FontSize="12" Margin="5"/>
                        <DataGrid Grid.Row="1" x:Name="dgExceptions"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 Background="White"
                                 BorderThickness="0"
                                 GridLinesVisibility="All"
                                 HeadersVisibility="Column"
                                 FontSize="11"
                                 Margin="5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="70"/>
                                <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!--  -->
                <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,5,0,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="比对记录" FontWeight="Bold" FontSize="12" Margin="5"/>
                        <DataGrid Grid.Row="1" x:Name="dgCompare"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 Background="#FFFFCC"
                                 BorderThickness="0"
                                 GridLinesVisibility="All"
                                 HeadersVisibility="Column"
                                 FontSize="11"
                                 Margin="5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="70"/>
                                <DataGridTextColumn Header="CCD数据" Binding="{Binding CCDData}" Width="120"/>
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 启动/停止服务按钮 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button x:Name="btnStartService" Content="启动服务" Style="{StaticResource StartButtonStyle}" Click="BtnStartService_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnStopService" Content="停止服务" Style="{StaticResource StopButtonStyle}" Click="BtnStopService_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
