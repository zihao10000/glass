<Window x:Class="GlassWarehouseSystem.ControlPlcUser1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="身份验证" 
        Width="400" 
        SizeToContent="Height" 
        WindowStartupLocation="CenterScreen" 
        Background="#F5F6F7">

    <Grid>
        <Border Background="White" CornerRadius="12" Margin="30" Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#DDDDDD" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <StackPanel x:Name="LoginPanel" VerticalAlignment="Center" Visibility="Visible">
                    <Ellipse Width="60" Height="60" Fill="#007ACC" Margin="0,0,0,25" HorizontalAlignment="Center"/>

                    <TextBlock Text="账号" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbUser" Height="35" VerticalContentAlignment="Center" Padding="5,0"
          BorderBrush="#DDD" BorderThickness="0,0,0,1" Margin="0,0,0,20"
          DisplayMemberPath="Username" SelectedValuePath="Username">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBox">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ComboBox.Resources>
                    </ComboBox>

                    <TextBlock Text="密码" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPwd" Height="35" VerticalContentAlignment="Center" Padding="5,0"
                                 BorderBrush="#DDD" BorderThickness="0,0,0,1" Margin="0,0,0,30"/>

                    <Button Content="立即登录" Click="BtnLogin_Click" Height="45" Cursor="Hand"
                            Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="修改管理员密码" Click="ShowUpdatePanel_Click" 
                            Background="Transparent" BorderThickness="0" Foreground="#999" 
                            Margin="0,15,0,0" Cursor="Hand" FontSize="12" Padding="5"/>
                </StackPanel>

                <StackPanel x:Name="UpdatePanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="修改账号密码" FontSize="16" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="账号" Foreground="#666" FontSize="12"/>
                    <ComboBox x:Name="cmbUpdateUser" Height="30" Margin="0,5,0,15" 
              BorderBrush="#EEE" BorderThickness="1" VerticalContentAlignment="Center"
              DisplayMemberPath="Username" SelectedValuePath="Username"/>

                    <TextBlock Text="旧密码" Foreground="#666" FontSize="12"/>
                    <PasswordBox x:Name="txtOldPwd" Height="30" Margin="0,5,0,15" BorderBrush="#EEE" BorderThickness="1" VerticalContentAlignment="Center"/>

                    <TextBlock Text="新密码" Foreground="#666" FontSize="12"/>
                    <PasswordBox x:Name="txtNewPwd" Height="30" Margin="0,5,0,25" BorderBrush="#EEE" BorderThickness="1" VerticalContentAlignment="Center"/>

                    <Button Content="保存修改" Click="BtnUpdatePwd_Click" Height="40" 
                            Background="#28A745" Foreground="White" BorderThickness="0" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="返回登录" Click="BackToLogin_Click" 
                            Background="Transparent" BorderThickness="0" Foreground="#999" 
                            Margin="0,10,0,0" Cursor="Hand" Padding="5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>