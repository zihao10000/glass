<Window x:Class="GlassWarehouseSystem.PrintWindowDraggable"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标签编辑" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Window.Resources>
        <!-- 标签样式 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>

        <!-- 文本框样式 -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 组合框样式 -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- ListBox样式 -->
        <Style x:Key="ListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- CheckBox样式 -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3,2"/>
        </Style>

        <!-- 可拖动元素样式 -->
        <Style x:Key="DraggableElementStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#E8E8E8" BorderBrush="#AAAAAA" BorderThickness="0,0,0,1">
            <Grid Height="32">
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <Button Content="打印设置标签" Style="{StaticResource ButtonStyle}" Width="90" Click="BtnPrintSettings_Click"/>
                    <Button Content="预览打印标签" Style="{StaticResource ButtonStyle}" Width="90" Click="BtnPreview_Click"/>
                    <Separator Width="1" Background="#AAAAAA" Margin="4,4"/>
                    <Button Content="保存布局" Style="{StaticResource ButtonStyle}" Width="80" Click="BtnSaveLayout_Click"
                            Background="#D4EDDA" BorderBrush="#5C9E6B" ToolTip="保存当前所有元素的位置布局到本地文件"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧字段列表 -->
            <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标签设置 -->
                    <StackPanel Grid.Row="0" Margin="5">
                        <TextBlock Text="标签设置" FontWeight="Bold" Margin="0,5"/>
                        
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="字体:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" x:Name="cboFontFamily" 
                                     Style="{StaticResource ComboBoxStyle}"
                                     SelectionChanged="CboFontFamily_SelectionChanged">
                                <ComboBoxItem Content="Arial" IsSelected="True"/>
                                <ComboBoxItem Content="宋体"/>
                                <ComboBoxItem Content="黑体"/>
                                <ComboBoxItem Content="微软雅黑"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="字号:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" x:Name="cboFontSize" 
                                     Style="{StaticResource ComboBoxStyle}"
                                     SelectionChanged="CboFontSize_SelectionChanged">
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="9"/>
                                <ComboBoxItem Content="10" IsSelected="True"/>
                                <ComboBoxItem Content="11"/>
                                <ComboBoxItem Content="12"/>
                                <ComboBoxItem Content="14"/>
                            </ComboBox>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <CheckBox x:Name="chkBold" Content="加粗" Style="{StaticResource CheckBoxStyle}" 
                                     Checked="ChkBold_Checked" Unchecked="ChkBold_Unchecked"/>
                            <CheckBox x:Name="chkItalic" Content="识别码编辑" Style="{StaticResource CheckBoxStyle}"/>
                        </StackPanel>

                        <Separator Margin="0,5"/>
                    </StackPanel>

                    <!-- 字段列表 -->
                    <GroupBox Grid.Row="1" Header="当前日期" Margin="5" Padding="2">
                        <ListBox x:Name="lstFields" Style="{StaticResource ListBoxStyle}" 
                                SelectionMode="Single"
                                MouseDoubleClick="LstFields_MouseDoubleClick">
                            <ListBoxItem Content="日期"/>
                            <ListBoxItem Content="时间"/>
                            <ListBoxItem Content="数量"/>
                            <ListBoxItem Content="分组"/>
                            <ListBoxItem Content="小片厚度总数"/>
                            <ListBoxItem Content="小片总分组"/>
                            <ListBoxItem Content="标签名称"/>
                            <ListBoxItem Content="计划日期"/>
                            <ListBoxItem Content="计划宽度"/>
                            <ListBoxItem Content="计划厚度"/>
                            <ListBoxItem Content="计划长度"/>
                            <ListBoxItem Content="长边"/>
                            <ListBoxItem Content="短边"/>
                            <ListBoxItem Content="厚边"/>
                            <ListBoxItem Content="层边"/>
                            <ListBoxItem Content="笼边"/>
                            <ListBoxItem Content="原产品名"/>
                            <ListBoxItem Content="原流程卡号"/>
                            <ListBoxItem Content="质量宽度"/>
                            <ListBoxItem Content="质量厚度"/>
                            <ListBoxItem Content="质量长度"/>
                            <ListBoxItem Content="归类ID"/>
                            <ListBoxItem Content="客户名称"/>
                            <ListBoxItem Content="订单编号"/>
                            <ListBoxItem Content="流水编号"/>
                            <ListBoxItem Content="属产品名"/>
                            <ListBoxItem Content="下一工序"/>
                        </ListBox>
                    </GroupBox>

                    <!-- 底部按钮 -->
                    <StackPanel Grid.Row="2" Margin="5">
                        <Button Content="添加文本" Style="{StaticResource ButtonStyle}" Click="BtnAddTextField_Click"/>
                        <Button Content="添加条形码" Style="{StaticResource ButtonStyle}" Click="BtnAddBarcode_Click"/>
                        <Button Content="添加二维码" Style="{StaticResource ButtonStyle}" Click="BtnAddQRCode_Click"/>
                        <Button Content="删除选中标签" Style="{StaticResource ButtonStyle}" Click="BtnDeleteSelected_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧预览区域 -->
            <Grid Grid.Column="1" Background="#D3D3D3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标尺工具栏 -->
                <Border Grid.Row="0" Background="#F0F0F0" Height="25" BorderBrush="#999" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0"/>
                    </Grid>
                </Border>

                <!-- 预览区域 -->
                <ScrollViewer Grid.Row="1" 
                             HorizontalScrollBarVisibility="Auto" 
                             VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="gridPreviewContainer" Margin="20">
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 横向标尺 -->
                            <Canvas Grid.Row="0" Grid.Column="1" x:Name="canvasHorizontalRuler" 
                                   Height="25" Background="White"/>

                            <!-- 纵向标尺 -->
                            <Canvas Grid.Row="1" Grid.Column="0" x:Name="canvasVerticalRuler" 
                                   Width="25" Background="White"/>

                            <!-- 预览画布 -->
                            <Border Grid.Row="1" Grid.Column="1" 
                                   Background="White" 
                                   BorderBrush="#666666" 
                                   BorderThickness="1"
                                   Width="750" Height="900">
                                <Canvas x:Name="canvasPreview" 
                                       Background="White" 
                                       ClipToBounds="True"
                                       MouseLeftButtonDown="CanvasPreview_MouseLeftButtonDown"
                                       MouseMove="CanvasPreview_MouseMove"
                                       MouseLeftButtonUp="CanvasPreview_MouseLeftButtonUp" Margin="0,0,0,158">
                                    
                                    <!-- 示例：可拖动的二维码 -->
                                    <Border x:Name="qrCodeElement" 
                                           Canvas.Left="50" Canvas.Top="50"
                                           Width="80" Height="80"
                                           Style="{StaticResource DraggableElementStyle}"
                                           MouseLeftButtonDown="Element_MouseLeftButtonDown"
                                           MouseMove="Element_MouseMove"
                                           MouseLeftButtonUp="Element_MouseLeftButtonUp">
                                        <Grid Background="White">
                                            <Rectangle Fill="Black" Width="70" Height="70" Margin="4,4,4,4"/>
                                        </Grid>
                                    </Border>

                                    <!-- 示例：可拖动的文本框 - 原始客户名 -->
                                    <Border x:Name="txtOriginalCustomer" 
                                           Canvas.Left="150" Canvas.Top="50"
                                           Style="{StaticResource DraggableElementStyle}"
                                           MouseLeftButtonDown="Element_MouseLeftButtonDown"
                                           MouseMove="Element_MouseMove"
                                           MouseLeftButtonUp="Element_MouseLeftButtonUp"
                                           Padding="5,3">
                                        <TextBlock Text="原始客户名" FontSize="14" FontWeight="Bold"/>
                                    </Border>

                                    <!-- 示例：可拖动的文本框 - 订单号 -->
                                    <Border x:Name="txtOrderNumber" 
                                           Canvas.Left="150" Canvas.Top="85"
                                           Style="{StaticResource DraggableElementStyle}"
                                           MouseLeftButtonDown="Element_MouseLeftButtonDown"
                                           MouseMove="Element_MouseMove"
                                           MouseLeftButtonUp="Element_MouseLeftButtonUp"
                                           Padding="5,3">
                                        <TextBlock Text="订单号" FontSize="14" FontWeight="Bold"/>
                                    </Border>

                                    <!-- 示例：可拖动的文本框 - 楼层编号 -->
                                    <Border x:Name="txtFloorNumber" 
                                           Canvas.Left="50" Canvas.Top="140"
                                           Style="{StaticResource DraggableElementStyle}"
                                           MouseLeftButtonDown="Element_MouseLeftButtonDown"
                                           MouseMove="Element_MouseMove"
                                           MouseLeftButtonUp="Element_MouseLeftButtonUp"
                                           Padding="5,3">
                                        <TextBlock Text="楼层编号" FontSize="12"/>
                                    </Border>

                                    <!-- 示例：可拖动的文本框 - 短边 x 长边 -->
                                    <Border x:Name="txtDimensions" 
                                           Canvas.Left="50" Canvas.Top="170"
                                           Style="{StaticResource DraggableElementStyle}"
                                           MouseLeftButtonDown="Element_MouseLeftButtonDown"
                                           MouseMove="Element_MouseMove"
                                           MouseLeftButtonUp="Element_MouseLeftButtonUp"
                                           Padding="5,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="短边 x " FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="长边" FontSize="14" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 示例：可拖动的文本框 - 属产品名 -->
                                    <Border x:Name="txtProductName" 
                                           Canvas.Left="50" Canvas.Top="205"
                                           Style="{StaticResource DraggableElementStyle}"
                                           MouseLeftButtonDown="Element_MouseLeftButtonDown"
                                           MouseMove="Element_MouseMove"
                                           MouseLeftButtonUp="Element_MouseLeftButtonUp"
                                           Padding="5,3">
                                        <TextBlock Text="属产品名" FontSize="12"/>
                                    </Border>

                                    <!-- 示例：可拖动的条形码区域 -->
                                    <Border x:Name="barcodeElement" 
                                           Canvas.Left="50" Canvas.Top="250"
                                           Width="200" Height="60"
                                           Style="{StaticResource DraggableElementStyle}"
                                           MouseLeftButtonDown="Element_MouseLeftButtonDown"
                                           MouseMove="Element_MouseMove"
                                           MouseLeftButtonUp="Element_MouseLeftButtonUp">
                                        <Grid Background="White">
                                            <Rectangle Fill="Transparent" Stroke="Gray" StrokeDashArray="2,2"/>
                                            <TextBlock Text="条形码区域" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      Foreground="Gray"/>
                                        </Grid>
                                    </Border>

                                </Canvas>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#E8E8E8" BorderBrush="#AAAAAA" BorderThickness="0,1,0,0">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="打印设置:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Button Content="打印正常" Style="{StaticResource ButtonStyle}" Width="80" Height="24"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="ID" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox x:Name="txtID" Text="5122000549" Width="100" Style="{StaticResource TextBoxStyle}"/>
                    <TextBlock Text="流程卡号" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox x:Name="txtProcessCard" Text="2G251220024-1-1" Width="120" Style="{StaticResource TextBoxStyle}"/>
                    <TextBlock Text="客户名称" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox x:Name="txtCustomer" Text="JS" Width="80" Style="{StaticResource TextBoxStyle}"/>
                    <TextBlock Text="订单编号" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox x:Name="txtOrder" Text="2G251220024" Width="100" Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0">
                    <Button Content="向上调整" Style="{StaticResource ButtonStyle}" Width="75" Height="24" Click="BtnMoveUp_Click"/>
                    <Button Content="向下调整" Style="{StaticResource ButtonStyle}" Width="75" Height="24" Click="BtnMoveDown_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
