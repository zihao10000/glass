<Window x:Class="GlassWarehouseSystem.CanShuGuanLi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GlassWarehouseSystem"
        mc:Ignorable="d"
        Title="参数管理" Height="600" Width="1000">

    <!-- 样式资源：移到最前面，确保先定义后使用 -->
    <Window.Resources>
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 主布局：左右两部分 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：参数列表 -->
        <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock Text="参数列表" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- 一级按钮：系统参数 -->
                <Expander Header="系统参数" IsExpanded="False" Margin="0,5" FontSize="12" FontWeight="Medium">
                    <StackPanel>
                        <Button Content="检测台设备参数" Margin="10,2" Click="OnSystemSubItemClick"/>
                        <Button Content="系统参数" Margin="10,2" Click="OnSystemSubItemClick"/>
                        <Button Content="理片笼设备参数" Margin="10,2" Click="OnSystemSubItemClick"/>
                        <Button Content="单向台设备参数" Margin="10,2" Click="OnSystemSubItemClick"/>
                        <Button Content="计划参数" Margin="10,2" Click="OnSystemSubItemClick"/>
                        <Button Content="比对参数" Margin="10,2" Click="OnSystemSubItemClick"/>
                        <Button Content="单向台运动参数" Margin="10,2" Click="OnSystemSubItemClick"/>
                        <Button Content="CCD参数" Margin="10,2" Click="OnSystemSubItemClick"/>
                    </StackPanel>
                </Expander>

                <!-- 一级按钮：PLC设备参数 -->
                <Expander Header="PLC设备参数" IsExpanded="False" Margin="0,5" FontSize="12" FontWeight="Medium">
                    <StackPanel>
                        <Button Content="检测台运动参数" Margin="10,2" Click="OnPlcSubItemClick"/>
                        <Button Content="检测台设备参数" Margin="10,2" Click="OnPlcSubItemClick"/>
                        <Button Content="理片笼运动参数" Margin="10,2" Click="OnPlcSubItemClick"/>
                        <Button Content="单向台运动参数" Margin="10,2" Click="OnPlcSubItemClick"/>
                        <Button Content="理片笼伺服参数" Margin="10,2" Click="OnPlcSubItemClick"/>
                        <Button Content="检测台伺服参数" Margin="10,2" Click="OnPlcSubItemClick"/>
                    </StackPanel>
                </Expander>

                <!-- 一级按钮：参数总览（无二级） -->
                <Button Content="参数总览" Margin="0,5" Click="OnOverviewClick" FontSize="12" FontWeight="Medium"/>
            </StackPanel>
        </Border>

        <!-- 右侧：参数设置 -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 参数设置标题 -->
            <TextBlock Text="参数设置" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- 参数表格 -->
            <DataGrid x:Name="dgParams" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                      AlternatingRowBackground="#F9F9F9" RowHeight="30" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80" />
                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="80"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 底部操作栏 -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="备份" Grid.Column="0" Margin="0,0,10,0" Width="60" Click="OnBackupClick"/>
                <Button Content="还原" Grid.Column="1" Margin="0,0,10,0" Width="60" Click="OnRestoreClick"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="权限选择：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="cboPermission" Width="120" SelectedIndex="0">
                        <ComboBoxItem Content="操作员"/>
                        <ComboBoxItem Content="管理员"/>
                    </ComboBox>
                </StackPanel>

                <Button Content="关闭" Grid.Column="4" Width="60" Click="OnCloseClick"/>
            </Grid>
        </Grid>
    </Grid>
</Window>