<Window x:Class="GlassWarehouseSystem.OutboundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="玻璃仓储管理系统 — 出笼"
        Height="900"
        Width="1600"
        WindowState="Maximized"
        Background="#EAEBED">

    <Window.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 菜单栏 -->
        <Border Grid.Row="0" Background="#D4D4D4">
            <Menu IsMainMenu="True" Background="#D4D4D4" FontSize="11">
                <MenuItem Header="系统(_X)">
                    <MenuItem Header="退出(_Q)" Click="MenuExit_Click"/>
                </MenuItem>
                <MenuItem Header="配置(_S)">
                    <MenuItem Header="参数设置(_P)" Click="OpenGlobalParams_Click"/>
                </MenuItem>
                <MenuItem Header="报表(_R)">
                    <MenuItem Header="看板(_S)" Click="MenuCageDashboard_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="#F5F5F5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="10,5">
                    <Button Style="{StaticResource ToolButtonStyle}" Height="39" Background="#5B9BD5" Foreground="White"
                            Click="BtnLoadMaterials_Click">
                        <TextBlock Text="刷新" FontSize="10" HorizontalAlignment="Center" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Height="39" Background="#5B9BD5" Foreground="White"
                            Click="OpenGlobalParams_Click">
                        <TextBlock Text="参数" FontSize="10" HorizontalAlignment="Center" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Height="39" Background="#5B9BD5" Foreground="White"
                            Click="MenuCageDashboard_Click">
                        <TextBlock Text="看板" FontSize="10" HorizontalAlignment="Center" Foreground="White"/>
                    </Button>
                    <Separator Width="1" Background="#CCCCCC" Margin="8,4"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Height="39" Width="70"
                            Background="#E07B00" BorderBrush="#C06A00" Foreground="White"
                            Click="BtnSwitchToInbound_Click">
                        <TextBlock Text="切换入笼" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧主面板 -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <!-- 操作按钮行 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Content="加载B笼物料" Style="{StaticResource ActionButtonStyle}" Click="BtnLoadMaterials_Click"/>
                    <Button Content="手动出笼" Style="{StaticResource ActionButtonStyle}" Click="BtnManualOutbound_Click"/>
                    <Button Content="导出出笼记录" Style="{StaticResource ActionButtonStyle}" Click="BtnExportOutbound_Click"/>
                    <Button Content="复位设备" Style="{StaticResource ActionButtonStyle}" Click="BtnResetPlc_Click"/>
                    <Separator Width="1" Height="24" Background="#AAAAAA" Margin="8,0"/>
                    <TextBlock Text="订单:" VerticalAlignment="Center" FontSize="11" Margin="0,0,5,0"/>
                    <Grid VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="btnOrderDropdown" Width="160" Height="28"
                                Click="BtnOrderDropdown_Click" HorizontalContentAlignment="Left"
                                Padding="6,0" FontSize="11" BorderBrush="#ABADB3" BorderThickness="1" Background="White">
                            <TextBlock x:Name="txtOrderDropdownLabel" Text="(全部)" VerticalAlignment="Center"/>
                        </Button>
                        <Popup x:Name="popupOrders" StaysOpen="False" Placement="Bottom"
                               PlacementTarget="{Binding ElementName=btnOrderDropdown}">
                            <Border Background="White" BorderBrush="#ABADB3" BorderThickness="1">
                                <StackPanel Width="280">
                                    <CheckBox x:Name="chkSelectAll" Content="(全选)" Margin="6,6,6,3"
                                              Click="ChkSelectAll_Click" FontSize="11"/>
                                    <Separator Margin="0,2"/>
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <ListBox x:Name="lstOrders" BorderThickness="0" FontSize="11">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayText}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              Margin="6,2" FontSize="11"
                                                              ToolTip="{Binding OrderId}"
                                                              Click="OrderCheckBox_Click"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                    <Separator Margin="0,2"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5,4">
                                        <Button Content="确认筛选" Width="65" Height="22" FontSize="10" Margin="0,0,4,0"
                                                Background="#0078D7" Foreground="White" BorderBrush="#005A9E"
                                                Click="BtnFilterByOrder_Click"/>
                                        <Button Content="显示全部" Width="65" Height="22" FontSize="10"
                                                Click="BtnShowAll_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- 出笼任务表格 -->
                <DataGrid Grid.Row="1" x:Name="dgOutboundTask"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         SelectionUnit="FullRow"
                         CanUserAddRows="False"
                         GridLinesVisibility="All"
                         HeadersVisibility="Column"
                         Background="White"
                         BorderBrush="#999999"
                         BorderThickness="1"
                         AlternatingRowBackground="#FFE5CC"
                         FontSize="12"
                         RowHeight="25"
                         Margin="0,0,0,5"
                         SelectionChanged="DgOutboundTask_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding SequenceNo}" Width="50"/>
                        <DataGridTextColumn Header="连组" Binding="{Binding GroupTag}" Width="40"/>
                        <DataGridTextColumn Header="GlassID" Binding="{Binding ID}" Width="120"/>
                        <DataGridTextColumn Header="流程卡" Binding="{Binding FlowCardNo}" Width="120"/>
                        <DataGridTextColumn Header="长边(mm)" Binding="{Binding Length, StringFormat={}{0:F3}}" Width="80"/>
                        <DataGridTextColumn Header="短边(mm)" Binding="{Binding Width, StringFormat={}{0:F3}}" Width="80"/>
                        <DataGridTextColumn Header="笼号" Binding="{Binding CageCode}" Width="60"/>
                        <DataGridTextColumn Header="层号" Binding="{Binding LayerNo}" Width="50"/>
                        <DataGridTextColumn Header="笼位" Binding="{Binding TargetPos, StringFormat={}{0:F1}}" Width="55"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                        <DataGridTextColumn Header="订单名称" Binding="{Binding OrderName}" Width="120"/>
                        <DataGridTextColumn Header="客户名称" Binding="{Binding ClientName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 详细信息 -->
                <Border Grid.Row="2" Background="#F9F9F9" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,5" Padding="5">
                    <StackPanel>
                        <TextBlock x:Name="txtDetailTitle" Text="详细信息" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock x:Name="txtDetailID" Text="GlassID: --" Width="180"/>
                            <TextBlock x:Name="txtDetailFlow" Text="流程卡: --" Width="180"/>
                            <TextBlock x:Name="txtDetailCage" Text="位置: --" Width="180"/>
                            <TextBlock x:Name="txtDetailOrder" Text="订单: --" Width="150"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtDetailSize" Text="长: --   宽: --   厚: --" Width="300"/>
                            <TextBlock x:Name="txtDetailStatus" Text="状态: --" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 出笼参数信息 -->
                <Border Grid.Row="3" Background="#E1D5E7" BorderBrush="#9673A6" BorderThickness="1" Padding="10,8" Margin="0,0,0,5">
                    <StackPanel>
                        <TextBlock Text="出笼参数" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtParamSort" Text="排序: --" FontSize="11" Width="250"/>
                            <TextBlock x:Name="txtParamTaskCount" Text="在库数量: 0" FontSize="11" Width="200"/>
                            <TextBlock x:Name="txtParamProgress" Text="完成进度: 0/0 (0%)" FontSize="11" Width="200"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 运行日志 -->
                <Border Grid.Row="4" Background="#D5E8D4" BorderBrush="#82B366" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="运行日志" FontWeight="Bold" Margin="5"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="txtLog"
                                    TextWrapping="Wrap"
                                    IsReadOnly="True"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    FontFamily="Courier New"
                                    FontSize="11"
                                    Padding="5"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右侧面板 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 出笼队列（按笼号/层号汇总） -->
                <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="出笼队列" FontWeight="Bold" FontSize="12" Margin="5"/>
                        <DataGrid Grid.Row="1" x:Name="dgOutboundQueue"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 Background="White"
                                 BorderThickness="0"
                                 GridLinesVisibility="All"
                                 HeadersVisibility="Column"
                                 FontSize="11"
                                 Margin="5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="笼号" Binding="{Binding CageCode}" Width="55"/>
                                <DataGridTextColumn Header="层号" Binding="{Binding LayerNo}" Width="40"/>
                                <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="40"/>
                                <DataGridTextColumn Header="笼位" Binding="{Binding TargetPos, StringFormat={}{0:F1}}" Width="55"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 出笼记录 -->
                <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,5,0,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="出笼记录" FontWeight="Bold" FontSize="12" Margin="5"/>
                        <DataGrid Grid.Row="1" x:Name="dgOutboundHistory"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 Background="#E8F5E9"
                                 BorderThickness="0"
                                 GridLinesVisibility="All"
                                 HeadersVisibility="Column"
                                 FontSize="11"
                                 Margin="5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="70"/>
                                <DataGridTextColumn Header="GlassID" Binding="{Binding GlassID}" Width="100"/>
                                <DataGridTextColumn Header="移动距离" Binding="{Binding MoveDistance, StringFormat={}{0:F1}}" Width="65"/>
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 启动/停止出笼按钮 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button x:Name="btnStartOutbound" Content="启动出笼" Width="100" Height="40" Background="#28A745" Foreground="White" FontSize="12" FontWeight="Bold" Click="BtnStartOutbound_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnStopOutbound" Content="停止出笼" Width="100" Height="40" Background="#DC3545" Foreground="White" FontSize="12" FontWeight="Bold" Click="BtnStopOutbound_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>