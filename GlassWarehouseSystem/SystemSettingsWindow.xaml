<Window x:Class="GlassWarehouseSystem.SystemSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统配置"
        Height="650"
        Width="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei, Segoe UI"
        TextOptions.TextFormattingMode="Display" 
        TextOptions.TextRenderingMode="ClearType"
        Background="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="MainBlue" Color="#0275D8"/>
        <SolidColorBrush x:Key="LightBlueBg" Color="#F0F8FF"/>
        <SolidColorBrush x:Key="TextBlue" Color="#004C99"/>
        <SolidColorBrush x:Key="ConfirmGreen" Color="#198754"/>
        <SolidColorBrush x:Key="BorderGray" Color="#CED4DA"/>
        <SolidColorBrush x:Key="TextDark" Color="#212529"/>

        <Style x:Key="TitleBlockStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LightBlueBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MainBlue}"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="CornerRadius" Value="0,4,4,0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBlue}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="0,6,6,6"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderBrush" Value="{StaticResource MainBlue}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}" Margin="0,0,4,0" CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource MainBlue}"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="2,2,2,0"/>
                                <Setter Property="Foreground" Value="{StaticResource MainBlue}"/>
                                <Setter Property="Margin" Value="0,-2,4,-2"/>
                                <Setter Property="Panel.ZIndex" Value="100"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#6C757D"/>
                                <Setter Property="Margin" Value="0,2,4,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="4" BorderThickness="1" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,20,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0" Panel.ZIndex="1">

            <TabItem Header="数据库配置">
                <Grid Margin="0">
                    <Border Style="{StaticResource CardStyle}" VerticalAlignment="Center" Height="478">
                        <StackPanel>
                            <Border Style="{StaticResource TitleBlockStyle}">
                                <TextBlock Text="数据库连接配置" Style="{StaticResource TitleTextStyle}"/>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="服务器地址：" Margin="0,10,8,10"/>
                                <TextBox x:Name="txtDbServerAddress" Grid.Row="0" Grid.Column="1" Margin="0,6,18,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="服务端口号：" Margin="0,10,8,10"/>
                                <TextBox x:Name="txtDbServerPort" Grid.Row="0" Grid.Column="3" Margin="0,6,0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="数据库服务器名称：" Margin="0,10,8,10"/>
                                <TextBox x:Name="txtDbName" Grid.Row="1" Grid.Column="1" Margin="0,6,18,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Redis端口号：" Margin="0,10,8,10"/>
                                <TextBox x:Name="txtRedisPort" Grid.Row="1" Grid.Column="3" Margin="0,6,0,6"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Redis库索引：" Margin="0,10,8,10"/>
                                <TextBox x:Name="txtRedisDbIndex" Grid.Row="2" Grid.Column="1" Height="32" Width="80" HorizontalAlignment="Left" Margin="0,6,18,6"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="PLC配置">
                <Grid Margin="0">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource TitleBlockStyle}">
                                    <TextBlock Text="PLC连接配置" Style="{StaticResource TitleTextStyle}"/>
                                </Border>
                                <TextBlock Text="PLC设备" Margin="0,0,0,8"/>
                                <Border BorderThickness="1" BorderBrush="{StaticResource BorderGray}" CornerRadius="4">
                                    <ListBox x:Name="lstPlcConnections" Height="330" BorderThickness="0" Background="#F8FAFC"
                                             SelectionChanged="LstPlcConnections_SelectionChanged" DisplayMemberPath="DisplayText"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource TitleBlockStyle}">
                                    <TextBlock Text="配置信息" Style="{StaticResource TitleTextStyle}"/>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ID：" Margin="0,8,8,8"/>
                                    <TextBox x:Name="txtPlcId" Grid.Row="0" Grid.Column="1" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="名称：" Margin="0,8,8,8"/>
                                    <TextBox x:Name="txtPlcName" Grid.Row="1" Grid.Column="1" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="PLC IP：" Margin="0,8,8,8"/>
                                    <TextBox x:Name="txtPlcIp" Grid.Row="2" Grid.Column="1" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="类型：" Margin="0,8,8,8"/>
                                    <ComboBox x:Name="cmbPlcType" Grid.Row="3" Grid.Column="1" Height="32" Margin="0,4,0,4" SelectedIndex="0">
                                        <ComboBoxItem Content="S71200"/>
                                        <ComboBoxItem Content="S71500"/>
                                        <ComboBoxItem Content="ModbusTcp"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="架号：" Margin="0,8,8,8"/>
                                    <TextBox x:Name="txtPlcRack" Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="槽号：" Margin="0,10,8,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,4,0,4">
                                        <TextBox x:Name="txtPlcSlot" Height="32" Width="80" HorizontalAlignment="Left"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button x:Name="btnAddPlc" Content="增加" Width="80" Height="32" Margin="0,0,12,0" 
                                                    Background="{StaticResource MainBlue}" Foreground="White" BorderThickness="0" Click="BtnAddPlc_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <Button x:Name="btnDeletePlc" Content="删除" Width="80" Height="32" 
                                                    Background="#FFFFFF" Foreground="#495057" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Click="BtnDeletePlc_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="标签打印配置">
                <Grid Margin="0">
                    <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Style="{StaticResource TitleBlockStyle}">
                                <TextBlock Text="打印机配置" Style="{StaticResource TitleTextStyle}"/>
                            </Border>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="标签打印机名称：" Margin="0,0,8,0"/>
                                <ComboBox x:Name="txtPrinterName" Grid.Column="1" Height="32" IsEditable="True"/>
                                <CheckBox x:Name="chkBatchPrint" Grid.Column="2" Content="批量打印" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextBlue}" FontWeight="Bold"/>
                            </Grid>

                            <Border Background="{StaticResource LightBlueBg}" BorderBrush="#99C2FF" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="打印机类型选择" Foreground="{StaticResource TextBlue}" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="rbPrintWindows" Content="Windows驱动打印" Margin="0,0,30,0" Foreground="{StaticResource TextDark}" FontWeight="Bold" IsChecked="True"/>
                                        <RadioButton x:Name="rbPrintNetwork" Content="网络指令打印" Foreground="{StaticResource TextDark}" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="280"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="打印服务端口：" Margin="0,8,8,8"/>
                                <TextBox x:Name="txtPrinterServicePort" Grid.Row="0" Grid.Column="1" Margin="0,4,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="打印服务端IP地址：" Margin="0,8,8,8"/>
                                <TextBox x:Name="txtPrinterServiceIp" Grid.Row="1" Grid.Column="1" Margin="0,4,0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="打印页面宽：" Margin="0,8,8,8"/>
                                <TextBox x:Name="txtPrinterPageWidth" Grid.Row="2" Grid.Column="1" Margin="0,4,0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="打印页面高：" Margin="0,8,8,8"/>
                                <TextBox x:Name="txtPrinterPageHeight" Grid.Row="3" Grid.Column="1" Margin="0,4,0,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,10">
            <Button x:Name="btnConfirm" Width="140" Height="42" Margin="0,0,25,0" Click="BtnConfirm_Click" BorderThickness="0" Cursor="Hand">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#20C997" Offset="0.0" />
                        <GradientStop Color="#20C997" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Text="确认" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnCancel" Width="140" Height="42" Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Click="BtnCancel_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <TextBlock Text="取消" Foreground="#495057" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>