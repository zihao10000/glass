<Window x:Class="GlassWarehouseSystem.CageDashboardWindowB"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="理片笼数据看板 - B笼" Height="800" Width="1200" Background="#1E1E1E">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                

                <StackPanel Orientation="Horizontal" Margin="20,0">
                    <Button Content="A 笼"  
            Click="SwitchToCageA_Click" Width="60" Height="35" Margin="5,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#333333" Foreground="White"/>

                    <RadioButton Content="B 笼" 
                 IsChecked="True" 
                 Style="{StaticResource {x:Type ToggleButton}}" 
                 Click="SwitchToCageB_Click" 
                 Width="60" Height="35" Margin="5,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="理片笼实时监控看板 - B笼" Foreground="RoyalBlue" FontSize="26" FontWeight="Bold" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding LayerList}" Margin="20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="12" Rows="10"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.SelectLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" Margin="2" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{Binding BackgroundColor}" BorderBrush="{Binding BorderColor}" BorderThickness="1.5" CornerRadius="2">
                                    <Grid>
                                        <TextBlock Text="{Binding LayerNo}" Foreground="White" FontSize="11" FontWeight="Bold" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" Opacity="0.8"/>

                                        <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,15,5,5" Stretch="Uniform">
                                            <Viewbox.Style>
                                                <Style TargetType="Viewbox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Viewbox.Style>
                                            <TextBlock Foreground="White" FontWeight="SemiBold" TextAlignment="Center">
                                                <Run Text="{Binding Length, StringFormat={}{0:F0}}"/>
                                                <Run Text=" x " Foreground="#AAAAAA"/>
                                                <Run Text="{Binding Width, StringFormat={}{0:F0}}"/>
                                                <Run Text=" x " Foreground="#AAAAAA"/>
                                                <Run Text="{Binding Thickness, StringFormat={}{0:F1}}"/>
                                            </TextBlock>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Background="#333333" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0">
                    <TextBlock Text="进出笼小片信息   当前选中层：" Foreground="#00FF00" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedLayer.LayerNo}" Foreground="#00FF00" FontSize="16" FontWeight="Bold" Margin="5,0"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="物料唯一ID" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SelectedLayer.MaterialID}" IsReadOnly="True" Background="#EEEEEE" Padding="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="长度 (mm)" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SelectedLayer.Length}" IsReadOnly="True" Background="#EEEEEE" Padding="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="宽度 (mm)" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SelectedLayer.Width}" IsReadOnly="True" Background="#EEEEEE" Padding="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="厚度 (mm)" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SelectedLayer.Thickness, StringFormat=F1}" IsReadOnly="True" Background="#EEEEEE" Padding="3"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="流程卡号" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SelectedLayer.FlowCardNo}" IsReadOnly="True" Background="#EEEEEE" Padding="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="订单号" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SelectedLayer.OrderNo}" IsReadOnly="True" Background="#EEEEEE" Padding="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="订序" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SelectedLayer.Sequence}" IsReadOnly="True" Background="#EEEEEE" Padding="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="客户名称" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SelectedLayer.ClientName}" IsReadOnly="True" Background="#EEEEEE" Padding="3"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>